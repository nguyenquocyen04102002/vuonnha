# ============================================================
# Copy file này thành ".env" (cùng thư mục với docker-compose.yml)
# rồi chỉnh sửa giá trị theo ý bạn trước khi chạy `docker compose up`
# ============================================================

# ---- PostgreSQL ----
# Lưu ý: mật khẩu có thể chứa ký tự đặc biệt (@, #, ...) một cách an toàn,
# vì backend dùng sqlalchemy.engine.URL.create() để tự encode, KHÔNG ghép chuỗi thủ công.
POSTGRES_USER=vuonnha
POSTGRES_PASSWORD=vuonnha_password
POSTGRES_DB=vuonnha_db

# ---- Bảo mật JWT ----
# Đổi giá trị này khi triển khai thật (production)! Có thể tạo chuỗi ngẫu nhiên bằng:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production

# ---- Tài khoản quản trị viên khởi tạo sẵn (được seed tự động) ----
ADMIN_EMAIL=admin@vuonnha.com
ADMIN_PASSWORD=Admin@123

# ---- Frontend ----
# Địa chỉ backend mà trình duyệt (frontend) sẽ gọi tới
VITE_API_URL=http://localhost:8000/api
# Origin của frontend, dùng để cấu hình CORS phía backend
FRONTEND_ORIGIN=http://localhost:5173

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@vuonnha.com
PGADMIN_PASSWORD=Admin@123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
